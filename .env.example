# Copie para .env e preencha. O .env nunca vai para o Git.

# Chave da YouTube Data API v3 (Google Cloud > APIs e serviços > Credenciais)
YOUTUBE_API_KEY=

# Opcional: limites locais de cota. Padrão do Google em 2026: 100 buscas e 10.000 unidades por dia.
# Aumente só se o seu projeto tiver cota extra aprovada.
# YTP_MAX_BUSCAS_DIA=100
# YTP_MAX_UNIDADES_DIA=10000
# YTP_CACHE=.cache/youtube.sqlite

# Opcional: envio para o Supabase. Use a secret key (sb_secret_...), nunca a publishable/anon.
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_TABLE=yt_channels
